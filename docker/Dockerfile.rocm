# FastGS – AMD ROCm production image
# Build: docker build -f docker/Dockerfile.rocm -t fastgs:rocm .
# Run:   docker run --device /dev/kfd --device /dev/dri --rm -it fastgs:rocm

ARG ROCM_VERSION=6.2.4
ARG UBUNTU_VERSION=22.04

FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
# Tell PyTorch / HIP which GPUs to use.  Override at runtime with --device.
ENV ROCR_VISIBLE_DEVICES=all
# Vendor-agnostic device selector (auto-detected, explicit override optional)
ENV FASTGS_DEVICE=cuda

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev python3-venv \
        git cmake ninja-build build-essential \
        libglib2.0-0 libsm6 libxext6 libxrender-dev libgl1 \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python && \
    pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /workspace

# Install PyTorch built for ROCm
ARG ROCM_VERSION
RUN ROCM_SHORT=$(echo "${ROCM_VERSION}" | cut -d. -f1,2) && \
    pip install --no-cache-dir \
        torch torchvision torchaudio \
        --index-url "https://download.pytorch.org/whl/rocm${ROCM_SHORT}"

# Copy project and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Build the HIP submodule extensions (PyTorch ROCm redirects nvcc → hipcc)
# --no-build-isolation because setup.py imports torch at the top level
COPY submodules/ submodules/
RUN pip install --no-cache-dir --no-build-isolation submodules/diff-gaussian-rasterization_fastgs && \
    pip install --no-cache-dir --no-build-isolation submodules/simple-knn && \
    pip install --no-cache-dir --no-build-isolation submodules/fused-ssim

# Copy the rest of the project
COPY . .

CMD ["python", "train.py", "--help"]
