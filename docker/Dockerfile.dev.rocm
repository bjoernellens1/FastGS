# FastGS – AMD ROCm development image
# Build: docker build -f docker/Dockerfile.dev.rocm -t fastgs:dev-rocm .
# Run:   docker run --device /dev/kfd --device /dev/dri --group-add video \
#                   --rm -it -p 8888:8888 -p 6006:6006 \
#                   -v $(pwd):/workspace fastgs:dev-rocm

ARG ROCM_VERSION=6.2.4
ARG UBUNTU_VERSION=22.04

FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV ROCR_VISIBLE_DEVICES=all
ENV FASTGS_DEVICE=cuda

# System dependencies + dev tools
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev python3-venv \
        git git-lfs cmake ninja-build build-essential \
        libglib2.0-0 libsm6 libxext6 libxrender-dev libgl1 \
        gdb htop \
        wget curl vim less \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python && \
    pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /workspace

# Install PyTorch built for ROCm
ARG ROCM_VERSION
RUN ROCM_SHORT=$(echo "${ROCM_VERSION}" | cut -d. -f1,2) && \
    pip install --no-cache-dir \
        torch torchvision torchaudio \
        --index-url "https://download.pytorch.org/whl/rocm${ROCM_SHORT}"

# Project Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Extra dev/research tooling
RUN pip install --no-cache-dir \
    jupyter jupyterlab ipython \
    tensorboard matplotlib seaborn \
    pytest pytest-cov \
    black isort flake8

# Build HIP extensions
COPY submodules/ submodules/
RUN pip install --no-cache-dir submodules/diff-gaussian-rasterization_fastgs && \
    pip install --no-cache-dir submodules/simple-knn && \
    pip install --no-cache-dir submodules/fused-ssim

COPY . .

EXPOSE 8888 6006

CMD ["/bin/bash"]
