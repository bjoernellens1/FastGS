# FastGS – NVIDIA CUDA development image
# Includes extra tooling: jupyter, tensorboard, gdb, nvtop, etc.
# Build: docker build -f docker/Dockerfile.dev.cuda -t fastgs:dev-cuda .
# Run:   docker run --gpus all --rm -it -p 8888:8888 -p 6006:6006 \
#                   -v $(pwd):/workspace fastgs:dev-cuda

ARG PYTORCH_VERSION=2.5.1
ARG CUDA_VERSION=12.4.1
ARG CUDNN_VERSION=9
ARG UBUNTU_VERSION=22.04

FROM nvidia/cuda:${CUDA_VERSION}-cudnn${CUDNN_VERSION}-devel-ubuntu${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV TORCH_CUDA_ARCH_LIST="7.0 7.5 8.0 8.6 8.9 9.0+PTX"

# System dependencies + dev tools
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev python3-venv \
        git git-lfs cmake ninja-build build-essential \
        libglib2.0-0 libsm6 libxext6 libxrender-dev libgl1 \
        libboost-dev \
        gdb valgrind htop nvtop \
        wget curl vim less \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python && \
    pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /workspace

# Install PyTorch for CUDA
ARG PYTORCH_VERSION
RUN pip install --no-cache-dir \
    "torch==${PYTORCH_VERSION}" \
    "torchvision" \
    "torchaudio" \
    --index-url https://download.pytorch.org/whl/cu124

# Project Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Extra dev/research tooling
RUN pip install --no-cache-dir \
    jupyter jupyterlab ipython \
    tensorboard matplotlib seaborn \
    pytest pytest-cov \
    black isort flake8 \
    open3d

# Build CUDA extensions
COPY submodules/ submodules/
RUN pip install --no-cache-dir submodules/diff-gaussian-rasterization_fastgs && \
    pip install --no-cache-dir submodules/simple-knn && \
    pip install --no-cache-dir submodules/fused-ssim

COPY . .

# Expose jupyter + tensorboard ports
EXPOSE 8888 6006

CMD ["/bin/bash"]
