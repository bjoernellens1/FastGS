# FastGS – NVIDIA CUDA production image
# Build: docker build -f docker/Dockerfile.cuda -t fastgs:cuda .
# Run:   docker run --gpus all --rm -it fastgs:cuda

ARG PYTORCH_VERSION=2.5.1
ARG CUDA_VERSION=12.1.1
ARG UBUNTU_VERSION=22.04

FROM nvidia/cuda:${CUDA_VERSION}-cudnn8-devel-ubuntu${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV TORCH_CUDA_ARCH_LIST="7.0 7.5 8.0 8.6 8.9 9.0+PTX"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev python3-venv \
        git cmake ninja-build build-essential \
        libglib2.0-0 libsm6 libxext6 libxrender-dev libgl1 \
        libboost-dev \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python && \
    pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /workspace

# Install PyTorch for CUDA 12.1
ARG PYTORCH_VERSION
RUN pip install --no-cache-dir \
    "torch==${PYTORCH_VERSION}" \
    "torchvision" \
    "torchaudio" \
    --index-url https://download.pytorch.org/whl/cu121

# Copy project and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Build the CUDA/C++ submodule extensions (--no-build-isolation because setup.py imports torch)
COPY submodules/ submodules/
RUN pip install --no-cache-dir --no-build-isolation submodules/diff-gaussian-rasterization_fastgs && \
    pip install --no-cache-dir --no-build-isolation submodules/simple-knn && \
    pip install --no-cache-dir --no-build-isolation submodules/fused-ssim

# Copy the rest of the project
COPY . .

# Default entry point
CMD ["python", "train.py", "--help"]
